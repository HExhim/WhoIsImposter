<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/dark_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_line">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_results_player_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ali"
                android:textColor="@color/text_white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Dynamic Role Pill -->
            <TextView
                android:id="@+id/tv_results_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="IMPOSTER"
                android:textColor="@color/text_white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/player_num_badge" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_results_secret_word"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Secret Word: Biryani"
            android:textColor="@color/text_grey_sub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_voted_out_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="[ VOTED OUT ]"
            android:textColor="@color/secondary_crimson"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
