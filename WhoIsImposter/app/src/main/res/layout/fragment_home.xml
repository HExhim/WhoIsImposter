<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dark_canvas">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- BRAND MAIN LOGO CONTAINER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logo_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:strokeWidth="0dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="16dp"
                android:paddingHorizontal="4dp"
                android:gravity="start">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCAL MULTIPLAYER"
                        android:textColor="@color/primary_indigo"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:layout_alignParentStart="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.4 PROD"
                        android:textColor="#66FFFFFF"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-monospace"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMPOSTOR?"
                    android:textColor="@color/text_white"
                    android:textSize="44sp"
                    android:textStyle="bold|italic"
                    android:letterSpacing="-0.04"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="The Ultimate Social Deduction Game"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="normal" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- MODE SELECTOR (Classic | Drawing) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mode_selector"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/dark_surface"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_line"
            app:layout_constraintTop_toBottomOf="@id/logo_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tab_classic"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="CLASSIC"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:textColor="@color/text_white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tab_drawing"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="DRAWING"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:textColor="@color/text_grey_sub" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TOP RIGHT SETTINGS GEAR ICON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_gear"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:icon="@drawable/ic_settings_gear"
            app:iconTint="@color/text_white"
            android:tag="btn_settings_gear"
            android:contentDescription="Settings"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- TOPICS SECTION HEADLINE -->
        <TextView
            android:id="@+id/tv_topics_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CHOOSE GAME TOPIC"
            android:textColor="@color/accent_lime"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            app:layout_constraintTop_toBottomOf="@id/card_mode_selector"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- MEHFIL TOPICS GRID CONTAINER -->
        <GridLayout
            android:id="@+id/topics_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            app:layout_constraintTop_toBottomOf="@id/tv_topics_headline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- MAJOR ACTIONS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_game"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="START MATCH"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/secondary_crimson"
            android:tag="start_game_button"
            android:contentDescription="Start a new match"
            app:layout_constraintTop_toBottomOf="@id/topics_grid"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_view_stats"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="STATISTICS &amp; HISTORY"
            android:textSize="15sp"
            android:textColor="@color/text_white"
            app:strokeColor="@color/primary_indigo"
            app:cornerRadius="16dp"
            android:tag="view_stats_button"
            android:contentDescription="View game diagnostics and history"
            app:layout_constraintTop_toBottomOf="@id/btn_start_game"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
