<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_suspect"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="@color/dark_surface_card"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_line">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_suspect_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Priya"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_suspect_votes" />

        <TextView
            android:id="@+id/tv_suspect_votes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="0 Votes"
            android:textColor="@color/secondary_crimson"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_cast_vote" />

        <!-- 48dp accessibly optimized voting touch-area -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cast_vote"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="VOTE"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/primary_indigo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
