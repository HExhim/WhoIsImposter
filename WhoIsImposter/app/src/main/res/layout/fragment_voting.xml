<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_canvas"
    android:padding="24dp">

    <!-- HEADER (Always Visible as constant context) -->
    <TextView
        android:id="@+id/voting_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECRET BALLOT"
        android:textColor="@color/text_white"
        android:textSize="26sp"
        android:textStyle="bold|italic"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_line"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/voting_title" />

    <!-- 1. UNLOCK / PIN PROTECTION CONTAINER -->
    <LinearLayout
        android:id="@+id/layout_voter_unlock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/dark_surface_card"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_line">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center_horizontal">

                <!-- Lock visual icon -->
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_secure"
                    app:tint="@color/secondary_crimson" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="CONFIDENTIAL VOTE"
                    android:textColor="@color/text_grey_sub"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_current_voter_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PLAYER"
                    android:textColor="@color/text_white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Please pass the phone to the player named above. To unlock your secret ballot, enter your PIN below:"
                    android:textColor="@color/text_grey_sub"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <!-- Password PIN Entry -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_layout_voter_pin"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="160.dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColorHint="@color/text_grey_hint"
                    app:boxStrokeColor="@color/secondary_crimson"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_voter_pin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_white" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unlock_ballot"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="28dp"
                    android:text="UNLOCK MY BALLOT"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/secondary_crimson" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 2. REAL BALLOT SELECTION CONTAINER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_ballot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tv_ballot_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOTER: PRIYA (Secret Vote)"
            android:textColor="@color/secondary_crimson"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_ballot_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tap exactly one player you suspect to be the Imposter. Double check before casting!"
            android:textColor="@color/text_grey_sub"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tv_ballot_caption"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- SUSPECTS CHOICE LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_voting_suspects"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_ballot_instructions"
            app:layout_constraintBottom_toTopOf="@id/btn_cast_secret_vote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cast_secret_vote"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CONFIRM MY SECRET VOTE"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/secondary_crimson"
            android:enabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 3. VOTING COMPLETE REVEAL CONTAINER -->
    <LinearLayout
        android:id="@+id/layout_voting_complete"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/dark_surface_card"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_line">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center_horizontal">

                <!-- Success checkmark visual icon -->
                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/btn_star_big_on" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="VOTES SECURED"
                    android:textColor="#39C0C8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="BALLOT LOCKED"
                    android:textColor="@color/text_white"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="All active players have finished casting their turn-by-turn votes safely. Hand the physical phone back to the game host."
                    android:textColor="@color/text_grey_sub"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tally_votes"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="32dp"
                    android:text="REVEAL MATCH RESULTS"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/secondary_crimson" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
